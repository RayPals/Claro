SAY "Welcome to the Claro quiz!"

ASK "What is your name?" name
SAY "Hello " + name + "!"

SET score 0

ASK "What is 2 + 2?" answer

IF answer = 4
    SAY "Correct!"
    SET score score + 1
ELSE
    SAY "Not quite. The answer is 4."
END
ASK "What is 5 + 5?" answer2

IF answer2 = 10
    SAY "Correct!"
    SET score score + 1
ELSE
    SAY "Not quite. The answer is 10."
END
SAY "Your final score is:"
SAY score

IF score = 2
    SAY "Great job!"
ELSE
    SAY "Good try. Keep practicing!"
END